# Виключити всю теку з бінарними файлами провайдерів та іншими службовими файлами
my-terraform-project/.terraform/
my-terraform-project/*.tfstate
my-terraform-project/*.tfstate.*
my-terraform-project/crash.log

# Включити lock-файл, як вимагає завдання (це скасовує виключення .terraform/)
!my-terraform-project/.terraform.lock.hcl